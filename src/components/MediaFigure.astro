---
import { site } from '../lib/settings';
interface Props {
  src: string; alt: string; caption?: string;
  width?: number; height?: number; eager?: boolean;
}
const { src, alt, caption, width, height, eager = false } = Astro.props;
---
<figure class="reading-figure">
  <a class="image-link" href={src} data-image-link aria-label={`${site.viewer.expand}: ${alt}`}>
    <img src={src} alt={alt} width={width} height={height} loading={eager ? 'eager' : 'lazy'} decoding="async" />
    <span class="image-hint" aria-hidden="true">{site.viewer.view}</span>
  </a>
  {caption && <figcaption>{caption}</figcaption>}
</figure>
